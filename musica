<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Angi ❤️</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: linear-gradient(135deg, #160823 0%, #3d0a1c 55%, #571231 100%);
            background-attachment: fixed;
            color: #ffe4ec;
            font-family: Georgia, 'Times New Roman', serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            overflow-x: hidden;
        }
        #hearts { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
        .heart {
            position: absolute;
            color: #ff5c8a;
            opacity: 0;
            animation: floatUp linear infinite;
            text-shadow: 0 0 12px rgba(255, 92, 138, 0.8);
        }
        @keyframes floatUp {
            0% { transform: translateY(30vh) scale(0.5) rotate(0deg); opacity: 0; }
            10% { opacity: 0.8; }
            90% { opacity: 0.6; }
            100% { transform: translateY(-95vh) scale(1.3) rotate(20deg); opacity: 0; }
        }
        .card {
            background: rgba(40, 10, 28, 0.72);
            border: 1px solid rgba(255, 107, 157, 0.4);
            border-radius: 24px;
            max-width: 600px;
            width: 100%;
            padding: 35px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.65), 0 0 60px rgba(255, 92, 138, 0.15);
            backdrop-filter: blur(8px);
            position: relative;
            z-index: 1;
        }
        .header { text-align: center; border-bottom: 1px solid rgba(255, 107, 157, 0.3); padding-bottom: 18px; margin-bottom: 22px; }
        .header h1 { color: #ff6b9d; font-size: 2rem; margin-bottom: 6px; }
        .header p { color: #f7b8cf; font-style: italic; font-size: 0.95rem; }
        .content { line-height: 1.85; font-size: 1.08rem; color: #ffe4ec; }
        .content p { margin-bottom: 18px; }
        .content .highlight { color: #ff9ec7; font-weight: bold; }
        .content h3 { color: #ff8fb3; margin: 22px 0 10px; font-size: 1.25rem; }
        .content p strong { color: #ff9ec7; }
        .footer { margin-top: 30px; border-top: 1px solid rgba(255, 107, 157, 0.3); padding-top: 18px; text-align: center; color: #e8a9bf; font-size: 0.9rem; font-style: italic; }
        .button-container { display: flex; justify-content: center; margin-top: 22px; }
        .copy-btn {
            background: linear-gradient(135deg, #ff4d7e, #ff7a59);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 1rem;
            font-family: inherit;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 6px 20px rgba(255, 77, 126, 0.4);
        }
        .copy-btn:hover { transform: scale(1.05); box-shadow: 0 8px 26px rgba(255, 77, 126, 0.6); }
        .music-options { display: flex; justify-content: center; gap: 12px; margin-bottom: 20px; }
        .music-btn { background: rgba(255, 255, 255, 0.08); color: #ffe4ec; border: 1px solid rgba(255, 107, 157, 0.5); padding: 10px 18px; border-radius: 25px; cursor: pointer; font-size: 0.95rem; font-family: inherit; transition: all 0.2s; }
        .music-btn:hover { background: rgba(255, 107, 157, 0.35); transform: scale(1.05); }
        @media (max-width: 480px) { .card { padding: 22px; } }
    </style>
</head>
<body>

    <div id="hearts"></div>
